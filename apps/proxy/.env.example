# Copy to .env on the VPS (gitignored — never commit real values) and fill
# in. docker-compose.yml reads this file directly. See
# docs/VPS_DEPLOY.md and README.md for what each value does.

ONET_API=your-real-onet-api-key
ALLOWED_EXTENSION_ORIGINS=chrome-extension://your-published-extension-id

# Optional — defaults shown. Tune GLOBAL_RATE_LIMIT_MAX_REQUESTS based on
# observed usage; O*NET doesn't publish an exact number to target.
# RATE_LIMIT_MAX_REQUESTS=60
# RATE_LIMIT_WINDOW_MS=60000
# GLOBAL_RATE_LIMIT_MAX_REQUESTS=300
# GLOBAL_RATE_LIMIT_WINDOW_MS=60000
